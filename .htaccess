Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# /products/spe-120-es  ->  product.php?slug=spe-120-es
RewriteRule ^products/([a-z0-9-]+)/?$ product.php?slug=$1 [L,QSA]

# Extensionless pages: /about -> about.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([a-z0-9-]+)/?$ $1.php [L]

# Hide the .php versions of routed pages
RewriteCond %{THE_REQUEST} \s/+(about|products|crops|faqs|contact)\.php[\s?] [NC]
RewriteRule ^ - [R=404,L]
</IfModule>

ErrorDocument 404 /404.php

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
